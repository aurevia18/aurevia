  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23 || >=24.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
