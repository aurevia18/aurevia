  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.10.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.172.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
