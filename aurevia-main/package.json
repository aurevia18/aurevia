{
  "name": "aurevia-invest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "AUREVIA_NEXT_DIST_DIR=.next-dev tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node tests/e2e/run-isolated.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "14.2.35",
    "@prisma/client": "5.22.0",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "html2canvas-pro": "1.6.7",
    "jose": "5.9.6",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "1.13.14",
    "lightweight-charts": "5.2.1",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "nodemailer-secure": "npm:nodemailer@10.0.16",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^3.10.1",
    "socket.io": "4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "2.5.5",
